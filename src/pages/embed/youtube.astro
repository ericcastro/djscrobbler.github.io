---
const pageTitle = 'DJ Scrobbler YouTube Embed';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{pageTitle}</title>
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #05070d;
        --panel: #0c1220;
        --border: #253460;
        --text: #e7f7ff;
        --muted: #8aa4d2;
        --accent: #00c2ff;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        width: 100%;
        height: 100%;
        margin: 0;
        overflow: hidden;
        color: var(--text);
        background: var(--bg);
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      }

      body {
        display: grid;
        place-items: stretch;
      }

      iframe {
        width: 100%;
        height: 100%;
        display: block;
        border: 0;
        background: #000;
      }

      /* ── YouTube UI overlays ──────────────────────────────────────────────────
         Absolutely-positioned black patches that sit above the iframe in the
         compositor, masking YouTube's native overlays (title card, pause icon,
         watermark, end screen) without needing cross-origin iframe access.

         Default: opacity 0 (invisible).  .active: opacity 1, instant (no
         transition on the way in so nothing bleeds through; smooth fade-out
         on the way back via the base transition). */

      main { position: relative; }

      .yt-overlay {
        position: absolute;
        background: #000;
        pointer-events: none;
        z-index: 10;
        opacity: 0;
        transition: opacity 0.3s ease;
      }
      .yt-overlay.active {
        opacity: 1;
        transition: none;
      }

      /* Title card — top strip */
      #yt-ov-top {
        top: 0; left: 0; right: 0;
        height: 72px;
      }

      /* Pause / play icon — centred circle */
      #yt-ov-center {
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 92px; height: 92px;
        border-radius: 50%;
      }

      /* End screen ("more videos") — full cover */
      #yt-ov-end { inset: 0; }


      .empty-state {
        min-height: 100%;
        display: grid;
        place-items: center;
        padding: 24px;
        text-align: center;
        background:
          linear-gradient(90deg, color-mix(in srgb, var(--border) 18%, transparent) 1px, transparent 1px),
          linear-gradient(180deg, color-mix(in srgb, var(--border) 14%, transparent) 1px, transparent 1px),
          var(--panel);
        background-size: 48px 48px;
      }

      .empty-state div {
        width: min(520px, 100%);
        padding: 22px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: color-mix(in srgb, var(--panel) 86%, transparent);
      }

      .empty-state strong {
        display: block;
        margin-bottom: 10px;
        color: var(--text);
        font-size: 16px;
      }

      .empty-state code,
      .empty-state p {
        color: var(--muted);
        font-size: 12px;
        line-height: 1.6;
      }

      .empty-state code {
        color: var(--accent);
      }
    </style>
  </head>
  <body>
    <main id="player-root" class="empty-state">
      <div>
        <strong>Missing YouTube video ID</strong>
        <p>Load this page with <code>?id=VIDEO_ID</code>, for example <code>/embed/youtube?id=dQw4w9WgXcQ</code>.</p>
      </div>
    </main>

    <script is:inline>
      const root = document.getElementById('player-root');
      const params = new URLSearchParams(window.location.search);

      function parseTimestamp(value) {
        if (!value) return '';
        if (/^\d+$/.test(value)) return value;

        const match = value.match(/^(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s?)?$/i);
        if (!match) return '';

        const hours = Number(match[1] || 0);
        const minutes = Number(match[2] || 0);
        const seconds = Number(match[3] || 0);
        const total = hours * 3600 + minutes * 60 + seconds;
        return total > 0 ? String(total) : '';
      }

      function extractVideoId() {
        const directId = params.get('id') || params.get('v') || params.get('videoId');
        if (directId) return directId;

        const rawUrl = params.get('url');
        if (!rawUrl) return '';

        try {
          const url = new URL(rawUrl);
          if (url.hostname === 'youtu.be') return url.pathname.split('/').filter(Boolean)[0] || '';
          if (url.hostname.endsWith('youtube.com')) {
            return url.searchParams.get('v') || url.pathname.split('/').filter(Boolean).pop() || '';
          }
        } catch {}

        return '';
      }

      function renderError(message) {
        root.className = 'empty-state';
        root.innerHTML = `<div><strong>${message}</strong><p>Expected a YouTube video ID in <code>?id=...</code>.</p></div>`;
      }

      const videoId = extractVideoId();
      const isValidVideoId = /^[a-zA-Z0-9_-]{6,32}$/.test(videoId);

      if (!isValidVideoId) {
        renderError(videoId ? 'Invalid YouTube video ID' : 'Missing YouTube video ID');
      } else {
        const embedParams = new URLSearchParams({
          autoplay: params.get('autoplay') || '1',
          controls: params.get('controls') || '0',
          enablejsapi: '1',
          playsinline: '1',
          rel: '0',
          origin: window.location.origin,
        });

        const start = parseTimestamp(params.get('start') || params.get('t'));
        if (start) embedParams.set('start', start);

        const iframe = document.createElement('iframe');
        iframe.id = 'yt-iframe';
        iframe.title = 'YouTube video player';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        iframe.src = `https://www.youtube.com/embed/${encodeURIComponent(videoId)}?${embedParams}`;

        // Create overlay divs that sit above the iframe in the compositor,
        // masking YouTube's native overlays without cross-origin iframe access.
        function mkOv(id) {
          const el = document.createElement('div');
          el.id = id;
          el.className = 'yt-overlay';
          return el;
        }
        const ovTop    = mkOv('yt-ov-top');
        const ovCenter = mkOv('yt-ov-center');
        const ovEnd    = mkOv('yt-ov-end');

        root.className = '';
        root.replaceChildren(iframe, ovTop, ovCenter, ovEnd);

        // Load the YouTube IFrame API and expose window.ytPlayer so DJ Scrobbler
        // can call playVideo / pauseVideo / getPlayerState / getCurrentTime / getDuration.
        const apiScript = document.createElement('script');
        apiScript.src = 'https://www.youtube.com/iframe_api';
        document.head.appendChild(apiScript);

        let _hideTimer = null;
        function onStateChange(event) {
          clearTimeout(_hideTimer);
          const s = event.data;
          if (s === 2 /* PAUSED */) {
            ovTop.classList.add('active');
            ovCenter.classList.add('active');
          } else if (s === 3 /* BUFFERING */) {
            ovTop.classList.add('active');
            ovCenter.classList.remove('active');
          } else if (s === 1 /* PLAYING */) {
            _hideTimer = setTimeout(() => {
              ovTop.classList.remove('active');
              ovCenter.classList.remove('active');
            }, 400);
            ovEnd.classList.remove('active');
          } else if (s === 0 /* ENDED */) {
            ovEnd.classList.add('active');
          }
        }

        window.onYouTubeIframeAPIReady = function () {
          // Wrap the already-rendered iframe. Only expose window.ytPlayer after
          // onReady fires — before that, seekTo / playVideo are silently ignored.
          const player = new YT.Player('yt-iframe', {
            events: {
              onReady: function () {
                window.ytPlayer = player;
              },
              onStateChange: onStateChange,
            }
          });
        };
      }
    </script>
  </body>
</html>
